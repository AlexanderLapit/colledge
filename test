from sqlalchemy import (
    Column, Integer, String, Numeric, Date, DateTime, Boolean, Text,
    ForeignKey, CheckConstraint, UniqueConstraint
)
from sqlalchemy.orm import declarative_base, relationship

Base = declarative_base()


class Contragent(Base):
    __tablename__ = "contragents"

    id = Column(Integer, primary_key=True)
    name = Column(String(200), nullable=False)
    inn = Column(String(20))
    addres = Column(String(200))
    phone = Column(String(20))
    type = Column(String(20), nullable=False)

    __table_args__ = (
        CheckConstraint("type in ('Поставщик', 'Покупатель')", name="contragents_type_check"),
    )

    specifications = relationship("Specification", back_populates="manufacturier")
    orders_by_customer = relationship("OrderByCustomer", back_populates="customer")


class Item(Base):
    __tablename__ = "items"

    id = Column(Integer, primary_key=True)
    name = Column(String(200), nullable=False)
    code = Column(String(200))
    type = Column(String(20), nullable=False)
    unit = Column(String(20))

    __table_args__ = (
        CheckConstraint("type in ('product', 'material', 'operation')", name="items_type_check"),
    )

    prices = relationship("Price", back_populates="item")
    specifications_as_product = relationship(
        "Specification", back_populates="product_item"
    )
    specification_lines = relationship(
        "SpecificationLine", back_populates="technological_item"
    )
    order_by_customer_lines = relationship(
        "OrderByCustomerLine", back_populates="product_item"
    )


class Price(Base):
    __tablename__ = "prices"

    id = Column(Integer, primary_key=True)
    item_id = Column(
        Integer,
        ForeignKey("items.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )
    price = Column(Numeric(12, 2), nullable=False)
    discount = Column(Integer, nullable=False)
    from_date = Column(Date, nullable=False)
    to_date = Column(Date, nullable=False)

    __table_args__ = (
        CheckConstraint("price >= 0", name="prices_price_check"),
        CheckConstraint("discount >= 0 and discount <= 100", name="prices_discount_check"),
    )

    item = relationship("Item", back_populates="prices")


class Specification(Base):
    __tablename__ = "specifiacations"

    id = Column(Integer, primary_key=True)
    product_item_id = Column(
        Integer,
        ForeignKey("items.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )
    manufacturier_id = Column(
        Integer,
        ForeignKey("contragents.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )

    product_item = relationship("Item", back_populates="specifications_as_product")
    manufacturier = relationship("Contragent", back_populates="specifications")
    lines = relationship(
        "SpecificationLine", back_populates="specification", cascade="all, delete-orphan"
    )
    order_lines = relationship("OrderByManufacturierLine", back_populates="specification")


class SpecificationLine(Base):
    __tablename__ = "specifiacation_lines"

    id = Column(Integer, primary_key=True)
    specifiacation_id = Column(
        Integer,
        ForeignKey("specifiacations.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )
    # technological item это операция или материал
    technological_item_id = Column(
        Integer,
        ForeignKey("items.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )
    quantity = Column(Numeric(12, 3), nullable=False)

    __table_args__ = (
        CheckConstraint("quantity >= 0", name="specification_lines_quantity_check"),
    )

    specification = relationship("Specification", back_populates="lines")
    technological_item = relationship("Item", back_populates="specification_lines")


class OrderByManufacturier(Base):
    __tablename__ = "orders_by_manufacturier"

    id = Column(Integer, primary_key=True)
    order_number = Column(Integer, nullable=False)
    date = Column(Date, nullable=False)

    lines = relationship(
        "OrderByManufacturierLine",
        back_populates="order",
        cascade="all, delete-orphan",
    )


class OrderByManufacturierLine(Base):
    __tablename__ = "order_by_manufacturier_lines"

    id = Column(Integer, primary_key=True)
    order_by_manufacturier_id = Column(
        Integer,
        ForeignKey("orders_by_manufacturier.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )
    specifiacation_id = Column(
        Integer,
        ForeignKey("specifiacations.id", onupdate="CASCADE", ondelete="RESTRICT"),
        nullable=False,
    )
    quantity = Column(Numeric(12, 3), nullable=False)

    __table_args__ = (
        CheckConstraint("quantity >= 0", name="order_by_manufacturier_lines_quantity_check"),
    )

    order = relationship("OrderByManufacturier", back_populates="lines")
    specification = relationship("Specification", back_populates="order_lines")


class OrderByCustomer(Base):
    __tablename__ = "orders_by_customer"

    id = Column(Integer, primary_key=True)
    order_number = Column(Integer, nullable=False)
    customer_id = Column(
        Integer,
        ForeignKey("contragents.id", onupdate="CASCADE", ondelete="RESTRICT"),
        nullable=False,
    )
    date = Column(Date, nullable=False)

    customer = relationship("Contragent", back_populates="orders_by_customer")
    lines = relationship(
        "OrderByCustomerLine",
        back_populates="order",
        cascade="all, delete-orphan",
    )


class OrderByCustomerLine(Base):
    __tablename__ = "order_by_customer_lines"

    id = Column(Integer, primary_key=True)
    product_item_id = Column(
        Integer,
        ForeignKey("items.id", onupdate="CASCADE", ondelete="RESTRICT"),
        nullable=False,
    )
    order_by_customer_id = Column(
        Integer,
        ForeignKey("orders_by_customer.id", onupdate="CASCADE", ondelete="CASCADE"),
        nullable=False,
    )
    quantity = Column(Numeric(12, 3), nullable=False)

    __table_args__ = (
        CheckConstraint("quantity >= 0", name="order_by_customer_lines_quantity_check"),
    )

    product_item = relationship("Item", back_populates="order_by_customer_lines")
    order = relationship("OrderByCustomer", back_populates="lines")


class User(Base):
    __tablename__ = "users"

    id = Column(Integer, primary_key=True)
    login = Column(String(50), unique=True)
    password_hash = Column(String(255))
    role = Column(String(20))
    is_blocked = Column(Boolean)
    failed_attempts = Column(Integer)
    blocked_until = Column(DateTime)
    created_at = Column(DateTime)

    notes = relationship("Note", back_populates="user", cascade="all, delete-orphan")


class Note(Base):
    __tablename__ = "notes"

    id = Column(Integer, primary_key=True)
    title = Column(String(255))
    content = Column(Text)
    user_id = Column(
        Integer,
        ForeignKey("users.id", onupdate="CASCADE", ondelete="CASCADE"),
    )
    created_at = Column(DateTime)

    user = relationship("User", back_populates="notes")
