import gradio as gr
import re

# "База данных" пользователей (в реальном проекте — БД)
users_db = {}

def register(username, email, password, confirm, age, gender, agree):
    # Проверка обязательных полей
    if not username or not email or not password:
        return "❌ Заполните все обязательные поля", ""

    # Проверка длины логина
    if len(username) < 3:
        return "❌ Логин должен быть не короче 3 символов", ""

    # Проверка email
    if not re.match(r"[^@]+@[^@]+\.[^@]+", email):
        return "❌ Некорректный email", ""

    # Проверка пароля
    if len(password) < 6:
        return "❌ Пароль должен быть не короче 6 символов", ""

    # Совпадение паролей
    if password != confirm:
        return "❌ Пароли не совпадают", ""

    # Согласие с условиями
    if not agree:
        return "❌ Необходимо согласиться с условиями", ""

    # Проверка на существующего пользователя
    if username in users_db:
        return f"❌ Пользователь '{username}' уже существует", ""

    # Сохраняем (в реальном проекте — хешировать пароль!)
    users_db[username] = {
        "email": email,
        "age": age,
        "gender": gender,
    }

    info = (
        f"✅ Регистрация успешна!\n\n"
        f"👤 Логин: {username}\n"
        f"📧 Email: {email}\n"
        f"🎂 Возраст: {age}\n"
        f"⚧ Пол: {gender}\n"
        f"👥 Всего пользователей: {len(users_db)}"
    )
    return "✅ Успешно", info


def clear_form():
    return "", "", "", "", 18, None, False, "", ""


with gr.Blocks(title="Регистрация", theme=gr.themes.Soft()) as demo:
    gr.Markdown("# 📝 Форма регистрации")
    gr.Markdown("Заполните поля ниже и нажмите **Зарегистрироваться**")

    with gr.Row():
        with gr.Column(scale=1):
            username = gr.Textbox(
                label="Логин *",
                placeholder="Введите логин (мин. 3 символа)"
            )
            email = gr.Textbox(
                label="Email *",
                placeholder="example@mail.com"
            )
            password = gr.Textbox(
                label="Пароль *",
                type="password",
                placeholder="Минимум 6 символов"
            )
            confirm = gr.Textbox(
                label="Подтвердите пароль *",
                type="password",
                placeholder="Повторите пароль"
            )
            age = gr.Slider(
                minimum=14, maximum=100, value=18, step=1,
                label="Возраст"
            )
            gender = gr.Radio(
                choices=["Мужской", "Женский", "Не указан"],
                value="Не указан",
                label="Пол"
            )
            agree = gr.Checkbox(
                label="Я согласен с условиями использования *"
            )

            with gr.Row():
                btn_submit = gr.Button("Зарегистрироваться", variant="primary")
                btn_clear = gr.Button("Очистить")

        with gr.Column(scale=1):
            status = gr.Textbox(label="Статус", interactive=False)
            result = gr.Textbox(
                label="Данные пользователя",
                lines=8,
                interactive=False
            )

    # Обработчики
    btn_submit.click(
        fn=register,
        inputs=[username, email, password, confirm, age, gender, agree],
        outputs=[status, result]
    )

    btn_clear.click(
        fn=clear_form,
        inputs=[],
        outputs=[username, email, password, confirm, age, gender, agree, status, result]
    )

demo.launch()
